<Window x:Class="MemoryOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Optimizer"
        Width="780"
        Height="540"
        MinWidth="660"
        MinHeight="460"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#607086"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#182231"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="内存优化" FontSize="28" FontWeight="SemiBold" Foreground="#142034"/>
                <TextBlock Text="Windows 物理内存状态与工作集优化" FontSize="14" Foreground="#607086" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Padding="10,6"
                    CornerRadius="6"
                    Background="#E9EEF5"
                    VerticalAlignment="Top">
                <TextBlock x:Name="AdminText" FontSize="13" Foreground="#334155"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="内存占用" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="MemoryLoadText" Style="{StaticResource MetricValue}"/>
                    <ProgressBar x:Name="MemoryBar"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Margin="0,0,0,24"/>

                    <TextBlock Text="可用内存" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="AvailableText" Style="{StaticResource MetricValue}"/>

                    <TextBlock Text="总内存" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TotalText" Style="{StaticResource MetricValue}"/>

                    <TextBlock Text="状态" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="StateText"
                               TextWrapping="Wrap"
                               Foreground="#182231"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/>
                        <Button x:Name="RecommendedButton" Content="推荐优化" Click="Recommended_Click"/>
                        <Button x:Name="FullButton" Content="深度优化" Click="Full_Click"/>
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Visibility="Collapsed"/>
                    </WrapPanel>

                    <ProgressBar x:Name="BusyBar"
                                 Grid.Row="1"
                                 Height="4"
                                 Margin="0,0,0,12"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"/>

                    <TextBox x:Name="LogBox"
                             Grid.Row="2"
                             Background="#101827"
                             Foreground="#D8E7FF"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="FooterText"
                   Margin="0,14,0,0"
                   Foreground="#607086"
                   FontSize="12"/>
    </Grid>
</Window>
