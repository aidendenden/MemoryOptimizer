<Window x:Class="MemoryOptimizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="#142034"/>
            <TextBlock x:Name="SubtitleText" Text="调整默认优化方式和窗口行为" Foreground="#607086" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="DefaultScopeLabel" Text="默认优化模式" Foreground="#334155" Margin="0,0,0,6"/>
            <ComboBox x:Name="DefaultScopeBox" Height="32" Margin="0,0,0,16"/>

            <CheckBox x:Name="AutoRefreshBox"
                      Content="自动刷新内存状态"
                      Margin="0,0,0,12"/>
            <CheckBox x:Name="AutoElevationBox"
                      Content="优化时自动请求管理员权限"
                      Margin="0,0,0,12"/>

            <TextBlock x:Name="RiskText"
                       Text="深度优化会额外清理文件缓存，机械硬盘环境下可能短时间卡顿。"
                       TextWrapping="Wrap"
                       Foreground="#8A5A00"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" MinWidth="76" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="保存" MinWidth="76" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
